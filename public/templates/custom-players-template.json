{
  "$schema": "volleyball-manager/custom-players@1",
  "note": "Custom-players JSON template for the Custom Save wizard's Custom draft pool. The wizard's 'Import JSON' button accepts either this shape (object with a 'players' array) or a bare top-level array. Every numeric stat must be an integer between 1 and 100 (potential is 1-99). Position must be one of: Outside Hitter, Middle Blocker, Opposite Hitter, Setter, Libero. Draft quota per team is 7 players (2 OH, 2 MB, 1 OPP, 1 S, 1 L) so the pool must contain at least quota x teams of every position.",

  "fields": {
    "player_name": "string (required) - display name",
    "position": "string (required) - one of: Outside Hitter, Middle Blocker, Opposite Hitter, Setter, Libero",
    "age": "integer 14-60",
    "country": "string - nationality, e.g. 'Italy'",
    "jersey_number": "integer 1-99",
    "height": "integer 140-230 (cm)",
    "potential": "integer 1-99 - target overall potential. Fanned out into 30 per-stat ceilings at seed time (each stat now has its own potential, derived from this single target).",
    "contract_years": "integer 1-10",
    "monthly_wage": "integer >= 0",
    "player_value": "integer >= 0",
    "stats_skill": ["attack", "defense", "serve", "block", "receive", "setting"],
    "stats_technical": ["precision", "flair", "digging", "positioning", "ball_control", "technique", "playmaking", "spin"],
    "stats_physical": ["speed", "agility", "strength", "endurance", "vertical", "flexibility", "torque", "balance"],
    "stats_mental": ["leadership", "teamwork", "concentration", "pressure", "consistency", "vision", "game_iq", "intimidation"]
  },

